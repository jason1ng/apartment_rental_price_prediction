# Data (loaded via load_csv.py / kagglehub at runtime — never commit CSVs)
data/**/*.csv
data/**/*.xlsx

# Notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
rent_env/

# OS/editor junk
.DS_Store
.vscode/*
!.vscode/settings.json

# Streamlit secrets (never commit API keys/tokens)
.streamlit/secrets.toml



# Model artifacts too large for GitHub. random_forest.pkl is ~544 MB, far over
# the 100 MB file limit, so it is committed as split parts in models/parts/
# instead (see src/model_parts.py). The app rebuilds it on first run.
models/random_forest.pkl

# Scratch files from splitting/joining
models/*.joining
models/parts/*.staged
